<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Avatar circle -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp">
        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_action_circle_blue" />
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person"
            android:tint="@color/primary"
            android:contentDescription="Patient" />
    </FrameLayout>

    <!-- Patient info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPatientItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Name"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvPatientItemPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="📞 Phone"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPatientItemAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Age: —"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Delete button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeletePatient"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        app:icon="@drawable/ic_delete"
        app:iconSize="18dp"
        app:iconTint="#EF4444"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        android:contentDescription="Delete patient" />

</LinearLayout>
